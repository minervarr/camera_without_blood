<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.USB_PERMISSION" />

    <!-- Keep capturing while backgrounded / screen off: a foreground service holds
         the process at foreground importance so Android does not revoke the camera,
         and a wake lock keeps the CPU developing/encoding with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.camera2" android:required="true" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="true" android:version="0" />

    <!-- Library manifest: contributes the camera scene + foreground service +
         permissions/features into the host. No <application> label/icon/theme so
         the host's own values win on merge. No MAIN/LAUNCHER (a library must not
         add a launcher icon to the host). -->
    <application>

        <activity
            android:name="io.nava.camera.CameraActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboardHidden|layoutDirection"
            android:screenOrientation="portrait"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:label="Camera">

            <meta-data
                android:name="android.app.lib_name"
                android:value="camera_recorder" />
        </activity>

        <service
            android:name="io.nava.camera.RecordingService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
